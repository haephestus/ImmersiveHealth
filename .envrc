# The #mc shell defaults JAVA_HOME to JDK 17 (required by Minecraft 1.20.1 /
# Forge 47 AND Gradle 8.1.1, which cannot run on JDK 21) and puts graphics libs
# on NIX_LD_LIBRARY_PATH so runClient's LWJGL/GLFW can initialise on NixOS.
# Launch the IDE from a shell in this dir with `idea-oss` so it inherits this env.
use flake /etc/nixos/modules/devshells#mc_1_20_1
